#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "app.manifest"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "PopTappo"
            VALUE "InternalName", "PopTappo"
            VALUE "OriginalFilename", "PopTappo.exe"
            VALUE "ProductName", "PopTappo"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL
IDD_TAP_RATE DIALOGEX 0, 0, 176, 88
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "自定义连点速度"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "每秒连点次数（1–100）", -1, 12, 12, 152, 12
    EDITTEXT        IDC_TAP_RATE, 12, 27, 70, 15, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "", IDC_TAP_RATE_ERROR, 12, 47, 152, 12
    DEFPUSHBUTTON   "确定", IDOK, 60, 65, 48, 15
    PUSHBUTTON      "取消", IDCANCEL, 116, 65, 48, 15
END
